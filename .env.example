# --- Database (Phase 1) ---
# Same variable name as the legacy Express app, so Atlas/Vercel config carries over unchanged.
ATLASDB_URL=

# --- Cloudinary (existing, unchanged) ---
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# --- Auth / NextAuth (Phase 2) ---
# Random 32+ byte secret, e.g. `openssl rand -base64 32`. Replaces the legacy SECRET
# (which had a hardcoded fallback — this one must be set, no fallback in the new app).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (Phase 5) ---
# Test-mode keys from the Stripe Dashboard while developing.
STRIPE_SECRET_KEY=
# Not currently read by any code — Checkout Sessions redirect to a
# Stripe-hosted page (session.url) rather than using client-side Stripe.js/
# Elements, so no publishable key is needed for this flow. Kept here in
# case that changes later.
STRIPE_PUBLISHABLE_KEY=
# For local dev, run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and use the "whsec_..." it prints — that's a different value from the
# webhook secret shown in the Dashboard for a deployed endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
